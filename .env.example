# Copia este archivo a `.env` y rellena con tu proyecto de Supabase o Postgres local.
# Nunca subas `.env` al repositorio.

# URI de Prisma en runtime. En Supabase usa el pooler de transacción (puerto 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa para migraciones. En Supabase usa Direct connection (puerto 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
