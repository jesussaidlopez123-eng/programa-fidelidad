{
  "name": "programa-fidelidad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "node scripts/check-env.mjs && prisma generate && node scripts/migrate-deploy.mjs && node scripts/seed-if-empty.mjs && next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "next lint",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "build:local": "prisma generate && next build",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^5.10.0",
    "lucide-react": "^1.71.0",
    "next": "^14.2.33",
    "react": "^18",
    "react-barcode": "^1.6.1",
    "react-dom": "^18",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
