generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CreditStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum RewardStatus {
  PENDING
  DELIVERED
}

enum Platform {
  PAYJOY
  KREDIYA
}

enum UserRole {
  SUCURSAL
  ADMIN
}

model User {
  id               String     @id @default(cuid())
  name             String     @unique
  passwordHash     String
  role             UserRole   @default(SUCURSAL)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  customersCreated Customer[]
  paymentsReceived Payment[]
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  barcodeId String   @unique
  createdAt DateTime @default(now())
  credits   Credit[]
  rewards   Reward[]

  createdById   String?
  createdBy     User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?

  platform Platform?
  model    String?
  imei     String?
  tagCurp  String?

  @@index([barcodeId])
  @@index([imei])
}

model Credit {
  id                String       @id @default(cuid())
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  concept           String
  totalAmount       Float
  balance           Float
  installmentAmount Float
  totalInstallments Int
  /// Plazo del crédito en semanas (alta). Null = clientes anteriores sin dato.
  totalWeeks        Int?
  paidInstallments  Int          @default(0)
  currentStreak     Int          @default(0)
  status            CreditStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  payments          Payment[]
  rewards           Reward[]

  @@index([customerId])
  @@index([status])
}

model Reward {
  id              String       @id @default(cuid())
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creditId        String
  credit          Credit       @relation(fields: [creditId], references: [id], onDelete: Cascade)
  rewardName      String
  status          RewardStatus @default(PENDING)
  unlockedAt      DateTime     @default(now())
  deliveredAt     DateTime?
  giftSlot        Int?
  marksRequired   Int?
  photoData       Bytes?
  photoMimeType   String?
  photoUploadedAt DateTime?
  unlockedByName  String?

  @@index([customerId])
  @@index([creditId])
  @@index([status])
  @@index([unlockedAt])
}

model Payment {
  id                      String   @id @default(cuid())
  creditId                String
  credit                  Credit   @relation(fields: [creditId], references: [id], onDelete: Cascade)
  amount                  Float?
  paymentDate             DateTime @default(now())
  isOnTime                Boolean
  streakCountAfterPayment Int
  notes                   String?

  receivedById   String?
  receivedBy     User?   @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  receivedByName String?

  @@index([creditId])
  @@index([paymentDate])
}

model AppSettings {
  id         String   @id @default("default")
  /// Días del ciclo desde el abono de referencia hasta el vencimiento (antes de gracia).
  cycleDays  Int      @default(7)
  graceDays  Int      @default(2)
  rewardEvery Int     @default(5)
  rewardName String   @default("Premio 5to Abono")
  /// Siguiente número de secuencia para tarjetas impresas / códigos CRD-######.
  nextCardSequence Int @default(1)
  /// Fondo activo de las siluetas (JPG/PNG) para impresión de lotes.
  cardBackgroundData     Bytes?
  cardBackgroundMimeType String?
  updatedAt  DateTime @updatedAt
}

/// Historial de lotes de códigos de barras impresos (sin crear clientes).
model CardPrintBatch {
  id            String   @id @default(cuid())
  fromNumber    Int
  toNumber      Int
  fromCode      String
  toCode        String
  quantity      Int
  createdAt     DateTime @default(now())
  createdByName String?

  @@index([createdAt])
  @@index([fromNumber, toNumber])
}

/// Configuración de los 3 regalos del programa (Regalo 1, 2 y 3).
/// marksRequired = null o vacío en la UI significa desactivado.
model GiftTier {
  id            String   @id @default(cuid())
  slot          Int      @unique
  name          String
  description   String   @default("")
  marksRequired Int?
  updatedAt     DateTime @updatedAt

  @@index([marksRequired])
}
